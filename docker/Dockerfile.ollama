# Recommendinator — Ollama sidecar image.
#
# Thin layer on top of ollama/ollama that bakes in the entrypoint script
# responsible for pulling the generation, embedding, and conversation models
# named by the OLLAMA_MODEL / OLLAMA_EMBEDDING_MODEL / OLLAMA_CONVERSATION_MODEL
# environment variables on first start.
# Published so end-users don't need to download a second file alongside
# docker-compose.yml.

# Pinned tag@digest for the reason the application Dockerfile gives.
FROM ollama/ollama:0.22.0@sha256:05ab093b257a54318fba39293f1640d53b507d1edec8fa6ca2d3e1817c02e53b

# The base runs as root and keeps its model store under /root. Pulling models is
# downloading files, so nothing here needs root; ollama follows HOME, and the
# compose volume mounts the store at the path this ENV decides.
RUN useradd --create-home --home-dir /var/lib/ollama --shell /bin/bash ollama
ENV HOME=/var/lib/ollama

COPY --chown=ollama:ollama ollama-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER ollama

# start_period is a placeholder, not a measurement: a first pull is documented
# at 5–15 minutes and nobody has timed one on a throttled link. 900s is the top
# of that range, erring long because a short one restarts a healthy download.
HEALTHCHECK --interval=10s --timeout=5s --start-period=900s --retries=3 \
    CMD ollama list > /dev/null 2>&1 && test -f /tmp/models-ready

ENTRYPOINT ["/entrypoint.sh"]
