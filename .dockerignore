# Deny by default: nothing reaches the builder unless named below, so private/,
# .env and config/config.yaml cannot ride in on a widened COPY. The exceptions
# are exactly what Dockerfile copies; tests/docker/test_compose.py holds them equal.
*

!.python-version
!config/example.yaml
!docker/entrypoint.sh
!env.d.ts
!index.html
!package.json
!pnpm-lock.yaml
!pyproject.toml
!resources
!src
!templates
!tsconfig.json
!uv.lock
!vite.config.ts

# Narrowing only, inside the trees above: the image builds its own frontend
# bundle and its own bytecode, and a host copy of either only ages.
src/web/static/dist
**/__pycache__
**/*.py[cod]
