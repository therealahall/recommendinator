# Node ships LTS on even majors only, and dependabot cannot express parity — a
# version list would need a new entry every odd major. `engines` states the
# supported range, so make pnpm refuse rather than warn: an unsupported base
# image fails the frontend build instead of shipping green.
engine-strict=true

# pnpm fetches its own Node, so nvm and PATH do not decide what builds here;
# without this a stale ~/.npmrc use-node-version silently wins. pnpm rejects a
# bare major, so this ages — harmlessly, since engines is what enforces.
use-node-version=24.20.0
